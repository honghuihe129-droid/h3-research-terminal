{
  "name": "h3-research-terminal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build_public_dist.js",
    "check": "node --check site/app.js && node scripts/validate_market_data.js site/data/market-data.json",
